# Required local assets
OPENPI_BASE_MODEL_PATH=/path/to/pi05_base_pytorch
OPENPI_ASSETS_DIR=/path/to/pi05_base_pytorch/assets/physical-intelligence
LARA_TOKENIZER_PATH=/path/to/latent_motion_tokenizer_checkpoint
LARA_VIT_MAE_PATH=/path/to/vit-mae-large

# Optional: set this to a writable/pre-populated PyTorch model cache on offline nodes.
# TORCH_HOME=<path-to-torch-cache>

# Dataset and output
LARA_LIBERO_DATASET=physical-intelligence/libero
LARA_OUTPUT_DIR=./outputs

# Distributed launch
LARA_NUM_GPUS=4
LARA_EXP_NAME=lara_pi05_libero
LARA_RESUME=0
