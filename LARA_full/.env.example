# Shared assets
LARA_BASE_MODEL_PATH=/path/to/GR00T-N1.5-3B
LARA_VIT_MAE_PATH=/path/to/vit-mae-large

# Outputs and stage hand-off
LARA_TOKENIZER_OUTPUT_DIR=./outputs/tokenizer
LARA_TOKENIZER_PATH=/path/to/tokenizer/checkpoint
LARA_PRETRAIN_OUTPUT_DIR=./outputs/lara_pretrain

# Stage 3 hand-off and output
LARA_STAGE2_CHECKPOINT=/path/to/lara_pretrain/checkpoint
# Optional for legacy checkpoints; otherwise the launcher uses the tokenizer
# saved under $LARA_STAGE2_CHECKPOINT/latent_motion_tokenizer.
# LARA_POSTTRAIN_TOKENIZER_PATH=/path/to/stage2/tokenizer/checkpoint
LARA_POSTTRAIN_OUTPUT_DIR=./outputs/lara_posttrain_libero_10

# Evaluation
LARA_EVAL_CHECKPOINT=/path/to/lara_full/checkpoint
LARA_EVAL_OUTPUT_DIR=./eval_outputs/lara_full_libero10

# Distributed launch
LARA_NUM_GPUS=4
